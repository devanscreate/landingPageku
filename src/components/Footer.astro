---
// src/components/Footer.astro
---

<footer id="kontak" class="w-full bg-[#000000] text-white pt-8 pb-12 border-t border-[#1a1a1a] relative">
  <!-- NVIDIA-style Green Accent Line at top of footer (Screenshot 5) -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-[#222222]">
    <div class="h-full bg-devr-green w-1/3"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <!-- Main Footer Columns Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-12 border-b border-[#222222]">
      <!-- Column 1: Layanan DEVR Studio -->
      <div>
        <h4 class="text-sm font-bold text-white mb-4 tracking-tight">
          Layanan DEVR Studio
        </h4>
        <ul class="space-y-2.5 text-xs text-[#888888]">
          <li><a href="#hero" class="hover:text-devr-green transition-colors">Landing Page Kustom Bisnis</a></li>
          <li><a href="#penawaran" class="hover:text-devr-green transition-colors">Preview UI Mockup Awal</a></li>
          <li><a href="#portofolio" class="hover:text-devr-green transition-colors">Website UMKM &amp; Kuliner</a></li>
          <li><a href="#portofolio" class="hover:text-devr-green transition-colors">Company Profile &amp; B2B</a></li>
          <li><a href="#fitur" class="hover:text-devr-green transition-colors">Integrasi WhatsApp &amp; Lead Form</a></li>
        </ul>
      </div>

      <!-- Column 2: Keunggulan & Alur -->
      <div>
        <h4 class="text-sm font-bold text-white mb-4 tracking-tight">
          Keunggulan &amp; Alur
        </h4>
        <ul class="space-y-2.5 text-xs text-[#888888]">
          <li><a href="#cara-kerja" class="hover:text-devr-green transition-colors">3 Langkah Kerja Mudah</a></li>
          <li><a href="#penawaran" class="hover:text-devr-green transition-colors">Garansi Revisi Pasti</a></li>
          <li><a href="#portofolio" class="hover:text-devr-green transition-colors">Portofolio &amp; Studi Kasus</a></li>
          <li><a href="#keunggulan" class="hover:text-devr-green transition-colors">Bebas Biaya Hosting Bulanan</a></li>
          <li><a href="#penawaran" class="hover:text-devr-green transition-colors">Kecepatan Muat &lt; 1 Detik</a></li>
        </ul>
      </div>

      <!-- Column 3: Konsultasi & Bantuan -->
      <div>
        <h4 class="text-sm font-bold text-white mb-4 tracking-tight">
          Konsultasi &amp; Bantuan
        </h4>
        <ul class="space-y-2.5 text-xs text-[#888888]">
          <li><a href="https://wa.me/" target="_blank" rel="noopener noreferrer" class="hover:text-devr-green transition-colors">Chat Langsung via WhatsApp</a></li>
          <li><a href="https://wa.me/" target="_blank" rel="noopener noreferrer" class="hover:text-devr-green transition-colors">Minta Penawaran Spesifik</a></li>
          <li><a href="#cara-kerja" class="hover:text-devr-green transition-colors">Panduan Serah Terima Website</a></li>
          <li><a href="#fitur" class="hover:text-devr-green transition-colors">Bantuan Pengelolaan Konten</a></li>
        </ul>
      </div>

      <!-- Column 4: Follow Social Media -->
      <div class="flex flex-col justify-between">
        <div>
          <h4 class="text-xs font-bold text-[#aaaaaa] uppercase tracking-wider mb-4">
            Follow DEVR
          </h4>
          <div class="flex items-center space-x-4 text-white">
            <!-- Facebook -->
            <a href="#" aria-label="Facebook" class="w-8 h-8 rounded-full bg-[#181818] flex items-center justify-center hover:bg-devr-green hover:text-black transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <!-- Instagram -->
            <a href="#" aria-label="Instagram" class="w-8 h-8 rounded-full bg-[#181818] flex items-center justify-center hover:bg-devr-green hover:text-black transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <!-- TikTok -->
            <a href="#" aria-label="TikTok" class="w-8 h-8 rounded-full bg-[#181818] flex items-center justify-center hover:bg-devr-green hover:text-black transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
            </a>
            <!-- GitHub / Code -->
            <a href="#" aria-label="GitHub" class="w-8 h-8 rounded-full bg-[#181818] flex items-center justify-center hover:bg-devr-green hover:text-black transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Quick CTA in footer -->
        <div class="mt-6">
          <p class="text-xs text-[#777777] mb-2 font-medium">Butuh landing page kustom untuk bisnis Anda?</p>
          <a
            href="https://wa.me/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold text-black bg-devr-green hover:bg-devr-green-hover rounded transition-all transform hover:scale-[1.02]"
          >
            <span>Hubungi Kami Sekarang</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Strip (Matches Screenshot 5) -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-[#777777] space-y-4 sm:space-y-0">
      <!-- DEVR Logo & Copyright -->
      <div class="flex items-center space-x-3">
        <div class="flex items-center gap-1.5">
          <svg class="w-5 h-4 text-devr-green" viewBox="0 0 32 24" fill="currentColor">
            <path d="M0 4.5C0 2.015 2.015 0 4.5 0h8.25c6.213 0 11.25 5.037 11.25 11.25v1.5C24 18.963 18.963 24 12.75 24H4.5A4.5 4.5 0 010 19.5v-15zm4.5 3.75v7.5h8.25c2.071 0 3.75-1.679 3.75-3.75s-1.679-3.75-3.75-3.75H4.5z"/>
          </svg>
          <span class="text-white font-extrabold text-sm tracking-wider">DEVR</span>
        </div>
        <span class="text-[#444]">&copy; 2026 DEVR Studio. Hak cipta dilindungi undang-undang.</span>
      </div>

      <!-- Legal Links -->
      <div class="flex items-center space-x-6 text-xs text-[#888888]">
        <a href="#kontak" class="hover:text-white transition-colors">Privacy Policy</a>
        <span class="text-[#444]">|</span>
        <a href="#kontak" class="hover:text-white transition-colors">Legal Info</a>
        <span class="text-[#444]">|</span>
        <a href="#kontak" class="hover:text-white transition-colors">Contact Us</a>
      </div>
    </div>
  </div>
</footer>
