---
// src/components/Hero.astro
---

<section class="relative w-full bg-gradient-to-b from-[#111111] via-[#080808] to-devr-bg overflow-hidden border-b border-devr-border pt-8 pb-4">
  <!-- Subtle background glow -->
  <div class="absolute inset-0 pointer-events-none opacity-20">
    <div class="absolute -top-32 left-1/4 w-96 h-96 bg-devr-green rounded-full blur-[128px]"></div>
    <div class="absolute top-1/2 right-10 w-80 h-80 bg-devr-green rounded-full blur-[160px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Main Hero Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center min-h-[440px] py-6">
      <!-- Left Column: Copywriting & CTA -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-block">
          <span id="hero-tag" class="text-xs uppercase font-bold tracking-widest text-devr-text-muted">
            Custom Web Experience
          </span>
        </div>

        <h1 id="hero-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-devr-text-primary tracking-tight leading-[1.15]">
          DEVR Web Engine <br class="hidden sm:inline" />Telah Hadir
        </h1>

        <p id="hero-desc" class="text-sm sm:text-base text-devr-text-secondary leading-relaxed max-w-xl font-normal">
          Kelas baru pembuatan landing page kustom berkecepatan tinggi yang dirancang untuk performa tanpa kompromi, rasio konversi maksimal, estetika modern, dan kebebasan tanpa batas template – kini siap mentransformasi bisnis Anda.
        </p>

        <div class="pt-2 flex flex-wrap gap-4 items-center">
          <a
            href="#kontak"
            id="hero-cta"
            class="inline-flex items-center justify-center px-6 py-2.5 text-xs sm:text-sm font-bold text-black bg-devr-green hover:bg-devr-green-hover rounded transition-all duration-200 transform hover:scale-[1.02] shadow-sm"
          >
            Pelajari Lebih
          </a>
          <a
            href="#portofolio"
            class="inline-flex items-center justify-center px-6 py-2.5 text-xs sm:text-sm font-semibold text-devr-text-primary border border-devr-border hover:border-devr-green hover:bg-devr-card rounded transition-all duration-200"
          >
            Lihat Showcase
          </a>
        </div>
      </div>

      <!-- Right Column: Visual / Product Showcase -->
      <div class="lg:col-span-6 flex justify-center items-center relative">
        <div class="relative w-full max-w-xl group">
          <!-- Ambient backlight glow -->
          <div class="absolute -inset-1 bg-gradient-to-r from-devr-green/30 to-emerald-500/10 rounded-2xl blur-xl opacity-40 group-hover:opacity-75 transition duration-500"></div>

          <div class="relative rounded-xl overflow-hidden bg-devr-card border border-devr-border shadow-2xl">
            <img
              id="hero-image"
              src="/assets/devr_hero_laptop.jpg"
              alt="DEVR Custom Landing Page Showcase"
              class="w-full h-auto object-cover transform hover:scale-[1.01] transition-transform duration-500"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=1200&q=80';"
            />
            <!-- RTX-style status badge -->
            <div class="absolute bottom-3 right-3 flex items-center gap-1.5 bg-black/80 backdrop-blur-md px-3 py-1 rounded border border-devr-green/50 text-[11px] font-bold text-white">
              <span class="w-2 h-2 rounded-full bg-devr-green animate-pulse"></span>
              DEVR CORE ON
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Carousel Tabs (Matches Screenshot 4) -->
    <div class="mt-8 pt-4 border-t border-[#222222]">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-3" id="hero-tabs">
        <!-- Tab 1 (Active by default) -->
        <button
          type="button"
          data-tab-index="0"
          class="hero-tab text-left py-2.5 px-3 rounded-sm border-t-2 border-devr-green bg-devr-card/40 hover:bg-devr-card transition-all duration-200"
        >
          <span class="block text-[11px] font-bold text-devr-text-muted uppercase tracking-wider">Custom Design</span>
          <span class="block text-xs font-semibold text-devr-text-primary truncate mt-0.5">DEVR Web Engine Telah Hadir</span>
        </button>

        <!-- Tab 2 -->
        <button
          type="button"
          data-tab-index="1"
          class="hero-tab text-left py-2.5 px-3 rounded-sm border-t-2 border-transparent hover:border-[#444] bg-transparent hover:bg-devr-card/30 transition-all duration-200"
        >
          <span class="block text-[11px] font-bold text-devr-text-muted uppercase tracking-wider">Performa Ekstrem</span>
          <span class="block text-xs font-semibold text-devr-text-secondary truncate mt-0.5">Zero-JS Core &amp; Skor 100</span>
        </button>

        <!-- Tab 3 -->
        <button
          type="button"
          data-tab-index="2"
          class="hero-tab text-left py-2.5 px-3 rounded-sm border-t-2 border-transparent hover:border-[#444] bg-transparent hover:bg-devr-card/30 transition-all duration-200"
        >
          <span class="block text-[11px] font-bold text-devr-text-muted uppercase tracking-wider">Tanpa Template</span>
          <span class="block text-xs font-semibold text-devr-text-secondary truncate mt-0.5">Desain 100% Kustom</span>
        </button>

        <!-- Tab 4 -->
        <button
          type="button"
          data-tab-index="3"
          class="hero-tab text-left py-2.5 px-3 rounded-sm border-t-2 border-transparent hover:border-[#444] bg-transparent hover:bg-devr-card/30 transition-all duration-200"
        >
          <span class="block text-[11px] font-bold text-devr-text-muted uppercase tracking-wider">CMS Headless</span>
          <span class="block text-xs font-semibold text-devr-text-secondary truncate mt-0.5">Edit Konten Bebas Ribet</span>
        </button>

        <!-- Tab 5 -->
        <button
          type="button"
          data-tab-index="4"
          class="hero-tab text-left py-2.5 px-3 rounded-sm border-t-2 border-transparent hover:border-[#444] bg-transparent hover:bg-devr-card/30 transition-all duration-200"
        >
          <span class="block text-[11px] font-bold text-devr-text-muted uppercase tracking-wider">Cloudflare Pages</span>
          <span class="block text-xs font-semibold text-devr-text-secondary truncate mt-0.5">Hosting Selamanya Gratis</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Hero Tabs Interactive Switcher
  const heroSlides = [
    {
      tag: "Custom Web Experience",
      heading: "DEVR Web Engine<br class='hidden sm:inline' /> Telah Hadir",
      desc: "Kelas baru pembuatan landing page kustom berkecepatan tinggi yang dirancang untuk performa tanpa kompromi, rasio konversi maksimal, estetika modern, dan kebebasan tanpa batas template – kini siap mentransformasi bisnis Anda.",
      cta: "Pelajari Lebih",
      img: "/assets/devr_hero_laptop.jpg"
    },
    {
      tag: "Arsitektur Ultra Ringan",
      heading: "Performa Instan Zero-JS<br class='hidden sm:inline' /> Skor 100/100",
      desc: "Dengan Astro.js, halaman dimuat sebagai HTML statis murni tanpa beban JavaScript yang berat. Pengunjung mengakses situs Anda dalam sekejap mata bahkan di jaringan seluler lambat.",
      cta: "Uji Kecepatan",
      img: "/assets/devr_showcase_cards.jpg"
    },
    {
      tag: "Eksklusif Dari Nol",
      heading: "Desain Kustom Murni<br class='hidden sm:inline' /> Tanpa Template Pasaran",
      desc: "Bebaskan identitas bisnis Anda dari batasan template pasaran WordPress atau Elementor. Setiap elemen UI dirancang teliti menggunakan Tailwind CSS & CSS Variables terstruktur.",
      cta: "Lihat Galeri Desain",
      img: "/assets/devr_creator_studio.jpg"
    },
    {
      tag: "Pengelolaan Konten Mandiri",
      heading: "Headless CMS Modern<br class='hidden sm:inline' /> Tanpa Biaya Server",
      desc: "Perbarui teks promosi, testimoni, atau portofolio dengan antarmuka CMS visual yang ramah pemula, langsung tersinkronisasi otomatis ke GitHub dan Cloudflare Pages.",
      cta: "Coba Demo CMS",
      img: "/assets/devr_split_comparison.jpg"
    },
    {
      tag: "Infrastruktur Edge Global",
      heading: "Hosting 100% Gratis<br class='hidden sm:inline' /> Di Cloudflare Pages",
      desc: "Manfaatkan jaringan server global Cloudflare dengan bandwidth tak terbatas, proteksi anti-DDoS kelas enterprise, dan sertifikat SSL otomatis tanpa biaya langganan bulanan.",
      cta: "Mulai Sekarang",
      img: "/assets/devr_hero_laptop.jpg"
    }
  ];

  const tabButtons = document.querySelectorAll('.hero-tab');
  const heroTag = document.getElementById('hero-tag');
  const heroHeading = document.getElementById('hero-heading');
  const heroDesc = document.getElementById('hero-desc');
  const heroCta = document.getElementById('hero-cta');
  const heroImage = document.getElementById('hero-image');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.getAttribute('data-tab-index') || '0', 10);
      const slide = heroSlides[idx];
      if (!slide) return;

      // Update active tab style
      tabButtons.forEach((b) => {
        b.classList.remove('border-devr-green', 'bg-devr-card/40');
        b.classList.add('border-transparent');
        const titleSpan = b.querySelectorAll('span')[1];
        if (titleSpan) {
          titleSpan.classList.remove('text-devr-text-primary');
          titleSpan.classList.add('text-devr-text-secondary');
        }
      });

      btn.classList.remove('border-transparent');
      btn.classList.add('border-devr-green', 'bg-devr-card/40');
      const activeSpan = btn.querySelectorAll('span')[1];
      if (activeSpan) {
        activeSpan.classList.remove('text-devr-text-secondary');
        activeSpan.classList.add('text-devr-text-primary');
      }

      // Update content
      if (heroTag) heroTag.textContent = slide.tag;
      if (heroHeading) heroHeading.innerHTML = slide.heading;
      if (heroDesc) heroDesc.textContent = slide.desc;
      if (heroCta) heroCta.textContent = slide.cta;
      if (heroImage && slide.img) heroImage.src = slide.img;
    });
  });
</script>
