---
// src/components/Hero.astro
---

<section id="hero" class="relative w-full bg-gradient-to-b from-devr-card/80 via-devr-bg to-devr-bg overflow-hidden border-b border-devr-border pt-8 pb-12 transition-colors">
  <!-- Subtle background glow -->
  <div class="absolute inset-0 pointer-events-none opacity-20">
    <div class="absolute -top-32 left-1/4 w-96 h-96 bg-devr-green rounded-full blur-[140px]"></div>
    <div class="absolute top-1/2 right-10 w-80 h-80 bg-devr-green rounded-full blur-[160px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Main Hero Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center min-h-[460px] py-6">
      <!-- Left Column: Copywriting & CTA -->
      <div class="lg:col-span-7 space-y-6">
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-devr-badge border border-devr-border text-xs font-bold uppercase tracking-wider text-devr-green shadow-sm">
            <span class="w-2 h-2 rounded-full bg-devr-green animate-pulse"></span>
            Layanan Pembuatan Landing Page Kustom
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-black text-devr-text-primary tracking-tight leading-[1.12]">
          UBAH PENGUNJUNG JADI PEMBELI. <br />
          <span class="text-devr-green">LIHAT DESAIN AWAL DULU</span> — BARU PUTUSKAN.
        </h1>

        <p class="text-base sm:text-lg text-devr-text-secondary leading-relaxed max-w-xl font-normal">
          Jangan beli kucing dalam karung. Kami buatkan konsep desain UI awal khusus bisnis Anda sebelum proyek dimulai. 100% kustom, kecepatan muat di bawah 1 detik, dan tanpa biaya langganan hosting bulanan.
        </p>

        <div class="pt-2 flex flex-wrap gap-4 items-center">
          <a
            href="https://wa.me/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-6 py-3.5 text-xs sm:text-sm font-bold text-devr-green-text bg-devr-green hover:bg-devr-green-hover rounded transition-all duration-200 transform hover:scale-[1.02] shadow-lg shadow-devr-green/20"
          >
            Minta Konsep Desain Sekarang &rarr;
          </a>
          <a
            href="#portofolio"
            class="inline-flex items-center justify-center px-6 py-3.5 text-xs sm:text-sm font-semibold text-devr-text-primary border border-devr-border hover:border-devr-green hover:bg-devr-card rounded transition-all duration-200"
          >
            Lihat Hasil Karya
          </a>
        </div>

        <!-- Trust micro-badges -->
        <div class="pt-2 flex items-center gap-6 text-xs text-devr-text-muted">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-devr-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Tanpa DP Di Awal
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-devr-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Revisi Dijamin
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-devr-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Hosting Gratis Selamanya
          </span>
        </div>
      </div>

      <!-- Right Column: Visual / Product Showcase -->
      <div class="lg:col-span-5 flex justify-center items-center relative">
        <div class="relative w-full max-w-lg group">
          <!-- Ambient backlight glow -->
          <div class="absolute -inset-1 bg-gradient-to-r from-devr-green/30 to-devr-green/10 rounded-2xl blur-xl opacity-40 group-hover:opacity-75 transition duration-500"></div>

          <div class="relative rounded-xl overflow-hidden bg-devr-card border border-devr-border shadow-2xl">
            <img
              id="hero-image"
              src="/assets/devr_hero_laptop.jpg"
              alt="DEVR Custom Landing Page Showcase"
              class="w-full h-auto object-cover transform hover:scale-[1.01] transition-transform duration-500"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=1200&q=80';"
            />
            <!-- Status badge -->
            <div class="absolute bottom-3 right-3 flex items-center gap-1.5 bg-devr-card/90 backdrop-blur-md px-3 py-1.5 rounded-lg border border-devr-border text-[11px] font-bold text-devr-text-primary shadow-lg">
              <span class="w-2 h-2 rounded-full bg-devr-green animate-pulse"></span>
              PREVIEW UI TERSEDIA
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section C: Quick Advantages Row -->
    <div id="keunggulan" class="mt-8 pt-6 border-t border-devr-border">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Box 1 -->
        <div class="p-5 rounded-xl bg-devr-card border border-devr-border hover:border-devr-green/60 shadow-sm hover:shadow-md transition-all duration-200 group">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-7 h-7 rounded-lg bg-devr-green/10 border border-devr-green/30 flex items-center justify-center text-devr-green">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <h3 class="text-sm font-black text-devr-text-primary tracking-wide uppercase group-hover:text-devr-green transition-colors">
              LIHAT UI DULU
            </h3>
          </div>
          <p class="text-xs text-devr-text-secondary leading-relaxed">
            Review konsep desain awal sebelum melangkah lebih jauh. Bebas cemas hasil tidak cocok.
          </p>
        </div>

        <!-- Box 2 -->
        <div class="p-5 rounded-xl bg-devr-card border border-devr-border hover:border-devr-green/60 shadow-sm hover:shadow-md transition-all duration-200 group">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-7 h-7 rounded-lg bg-devr-green/10 border border-devr-green/30 flex items-center justify-center text-devr-green">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <h3 class="text-sm font-black text-devr-text-primary tracking-wide uppercase group-hover:text-devr-green transition-colors">
              GARANSI REVISI
            </h3>
          </div>
          <p class="text-xs text-devr-text-secondary leading-relaxed">
            Kami sempurnakan tata letak, warna, dan konten hingga presisi dan sesuai selera Anda.
          </p>
        </div>

        <!-- Box 3 -->
        <div class="p-5 rounded-xl bg-devr-card border border-devr-border hover:border-devr-green/60 shadow-sm hover:shadow-md transition-all duration-200 group">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-7 h-7 rounded-lg bg-devr-green/10 border border-devr-green/30 flex items-center justify-center text-devr-green">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-sm font-black text-devr-text-primary tracking-wide uppercase group-hover:text-devr-green transition-colors">
              BEBAS BIAYA BULANAN
            </h3>
          </div>
          <p class="text-xs text-devr-text-secondary leading-relaxed">
            Termasuk hosting super cepat gratis selamanya tanpa tagihan server tahunan yang membebani.
          </p>
        </div>

        <!-- Box 4 -->
        <div class="p-5 rounded-xl bg-devr-card border border-devr-border hover:border-devr-green/60 shadow-sm hover:shadow-md transition-all duration-200 group">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-7 h-7 rounded-lg bg-devr-green/10 border border-devr-green/30 flex items-center justify-center text-devr-green">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-sm font-black text-devr-text-primary tracking-wide uppercase group-hover:text-devr-green transition-colors">
              SIAP PAKAI
            </h3>
          </div>
          <p class="text-xs text-devr-text-secondary leading-relaxed">
            Terintegrasi rapi dengan WhatsApp bisnis Anda agar calon pembeli langsung terhubung.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
