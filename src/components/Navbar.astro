---
// src/components/Navbar.astro
import ThemeToggle from './ThemeToggle.astro';
---

<header class="w-full sticky top-0 z-50 bg-devr-navbar/95 backdrop-blur-md border-b border-devr-border transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Left: DEVR Studio Branding -->
      <div class="flex items-center space-x-8">
        <a href="/" class="flex items-center gap-2 group" aria-label="DEVR Studio Homepage">
          <!-- Emblem SVG -->
          <svg class="w-6 h-5 text-devr-green transition-transform group-hover:scale-105" viewBox="0 0 32 24" fill="currentColor">
            <path d="M0 4.5C0 2.015 2.015 0 4.5 0h8.25c6.213 0 11.25 5.037 11.25 11.25v1.5C24 18.963 18.963 24 12.75 24H4.5A4.5 4.5 0 010 19.5v-15zm4.5 3.75v7.5h8.25c2.071 0 3.75-1.679 3.75-3.75s-1.679-3.75-3.75-3.75H4.5z"/>
            <path d="M26.5 6a3.5 3.5 0 013.5 3.5v5a3.5 3.5 0 01-7 0v-5a3.5 3.5 0 013.5-3.5z" opacity="0.9"/>
          </svg>
          <span class="text-devr-text-primary font-bold text-lg tracking-tight hover:text-devr-green transition-colors">
            DEVR <span class="text-devr-green">Studio</span>
          </span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center space-x-6 text-[13px] font-medium" aria-label="Navigasi Utama">
          <a href="/keunggulan" class="text-devr-text-secondary hover:text-devr-green transition-colors">
            Keunggulan
          </a>
          <a href="/cara-kerja" class="text-devr-text-secondary hover:text-devr-green transition-colors">
            Cara Kerja
          </a>
          <a href="/portofolio" class="text-devr-text-secondary hover:text-devr-green transition-colors">
            Portofolio
          </a>
          <a href="/fitur" class="text-devr-text-secondary hover:text-devr-green transition-colors">
            Fitur Lengkap
          </a>
          <a href="/penawaran" class="text-devr-text-secondary hover:text-devr-green transition-colors">
            Paket &amp; Penawaran
          </a>
        </nav>
      </div>

      <!-- Right: Language Selector, Theme Toggle, CTA & Mobile Menu Toggle -->
      <div class="flex items-center space-x-2 sm:space-x-3">
        <!-- Language selector -->
        <button
          type="button"
          class="flex items-center gap-1 text-devr-text-muted hover:text-devr-text-primary text-xs font-medium transition-colors"
          title="Pilih Bahasa"
          aria-label="Pilih Bahasa Indonesia"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke-width="1.8" />
            <path stroke-width="1.8" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z" />
          </svg>
          <span class="font-bold text-[11px] tracking-wider">ID</span>
        </button>

        <!-- Dynamic Theme Toggle -->
        <ThemeToggle />

        <!-- CTA Button (Visible on screens >= sm) -->
        <a
          href="https://wa.me/"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center px-3.5 py-1.5 text-xs font-bold text-devr-green-text bg-devr-green hover:bg-devr-green-hover rounded-lg transition-all duration-200 transform hover:-translate-y-0.5 shadow-sm whitespace-nowrap"
        >
          Minta Desain Awal
        </a>

        <!-- Mobile Menu Button (Visible on screens < lg) -->
        <div class="flex lg:hidden items-center">
          <button
            id="mobile-menu-btn"
            type="button"
            class="p-1.5 sm:p-2 text-devr-text-secondary hover:text-devr-text-primary focus:outline-none rounded hover:bg-devr-card transition-colors"
            aria-label="Toggle Menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-devr-border bg-devr-card px-4 pt-2 pb-4 space-y-2">
    <a href="/keunggulan" class="block py-2 text-sm text-devr-text-secondary hover:text-devr-green">Keunggulan</a>
    <a href="/cara-kerja" class="block py-2 text-sm text-devr-text-secondary hover:text-devr-green">Cara Kerja</a>
    <a href="/portofolio" class="block py-2 text-sm text-devr-text-secondary hover:text-devr-green">Portofolio</a>
    <a href="/fitur" class="block py-2 text-sm text-devr-text-secondary hover:text-devr-green">Fitur Lengkap</a>
    <a href="/penawaran" class="block py-2 text-sm text-devr-text-secondary hover:text-devr-green">Paket &amp; Penawaran</a>
    <div class="pt-2">
      <a
        href="https://wa.me/"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full text-center py-2.5 text-xs font-bold text-devr-green-text bg-devr-green hover:bg-devr-green-hover rounded-lg shadow-sm"
      >
        Minta Desain Awal Gratis
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const navLinks = document.querySelectorAll('header nav a[href^="/"], #mobile-menu a[href^="/"]');
  const sections = document.querySelectorAll('section[id], footer[id]');
  const NAV_OFFSET = 64; // Standard sticky navbar height (4rem / h-16)
  const VALID_SECTIONS = new Set(['hero', 'keunggulan', 'cara-kerja', 'portofolio', 'fitur', 'penawaran', 'kontak']);

  // Mobile menu button toggle
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Extract section ID from href or path (e.g., '/cara-kerja' or '#cara-kerja' -> 'cara-kerja')
  function getSectionIdFromHref(href) {
    if (!href) return null;
    if (href === '/' || href === '#hero' || href === '/hero') return 'hero';
    const clean = href.replace(/^[/#]+/, '').replace(/\/+$/, '');
    return VALID_SECTIONS.has(clean) ? clean : null;
  }

  // Update active state styling on nav items
  function setActiveNav(sectionId) {
    const activePath = sectionId && sectionId !== 'hero' ? `/${sectionId}` : '';
    navLinks.forEach((link) => {
      if (link.getAttribute('href') === activePath) {
        link.classList.add('text-devr-green', 'font-bold');
        link.classList.remove('text-devr-text-secondary');
      } else {
        link.classList.remove('text-devr-green', 'font-bold');
        link.classList.add('text-devr-text-secondary');
      }
    });
  }

  // Smooth scroll to target section and update URL with clean path (no #)
  function scrollToSection(sectionId, updateHistory = true, smooth = true) {
    const target = document.getElementById(sectionId);
    if (!target) return;

    const targetTop = sectionId === 'hero'
      ? 0
      : target.getBoundingClientRect().top + window.pageYOffset - NAV_OFFSET;

    window.scrollTo({
      top: Math.max(0, targetTop),
      behavior: smooth ? 'smooth' : 'auto'
    });

    if (updateHistory) {
      const cleanUrl = sectionId === 'hero' ? '/' : `/${sectionId}`;
      if (window.location.pathname !== cleanUrl || window.location.hash) {
        history.pushState({ sectionId }, '', cleanUrl);
      }
    }
  }

  // Intercept all internal section links across the page (Navbar, Hero, Footer, CTA)
  document.addEventListener('click', (e) => {
    const link = e.target.closest('a[href]');
    if (!link) return;

    const href = link.getAttribute('href');
    if (href === '#') {
      e.preventDefault();
      return;
    }

    const sectionId = getSectionIdFromHref(href);
    if (sectionId) {
      e.preventDefault();
      if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
        mobileMenu.classList.add('hidden');
      }
      setActiveNav(sectionId);
      scrollToSection(sectionId, true, true);
    }
  });

  // Handle direct URL visit (e.g. /cara-kerja) or legacy hash URL (e.g. /#cara-kerja) on load
  window.addEventListener('DOMContentLoaded', () => {
    const hashSection = getSectionIdFromHref(window.location.hash);
    const pathSection = getSectionIdFromHref(window.location.pathname);
    const initialSection = hashSection || (pathSection !== 'hero' ? pathSection : null);

    if (initialSection) {
      const cleanUrl = initialSection === 'hero' ? '/' : `/${initialSection}`;
      history.replaceState({ sectionId: initialSection }, '', cleanUrl);
      setActiveNav(initialSection);
      requestAnimationFrame(() => {
        scrollToSection(initialSection, false, false);
      });
    }
  });

  // Handle browser Back / Forward buttons
  window.addEventListener('popstate', () => {
    const sectionId = getSectionIdFromHref(window.location.pathname) || 'hero';
    setActiveNav(sectionId);
    scrollToSection(sectionId, false, true);
  });

  // Active section spy on scroll
  if ('IntersectionObserver' in window && sections.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          setActiveNav(id);
        }
      });
    }, {
      rootMargin: '-20% 0px -60% 0px',
      threshold: 0
    });

    sections.forEach((sec) => observer.observe(sec));
  }
</script>
