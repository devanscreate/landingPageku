---
// src/components/PortfolioSection.astro
---

<section id="portofolio" class="py-16 bg-devr-bg border-b border-devr-border transition-colors scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header: Title & Navigation Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div>
        <span class="text-xs uppercase font-extrabold tracking-widest text-devr-green block mb-1">
          PORTOFOLIO KAMI
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-devr-text-primary tracking-tight">
          COCOK UNTUK BERBAGAI JENIS USAHA
        </h2>
        <p class="text-xs sm:text-sm text-devr-text-secondary mt-1.5 max-w-2xl">
          Apapun bidang bisnis Anda, kami rancang tampilan website yang paling pas untuk menarik pelanggan.
        </p>
      </div>

      <!-- Navigation Arrows -->
      <div class="flex items-center space-x-2 self-end sm:self-auto">
        <button
          type="button"
          id="port-prev-btn"
          aria-label="Geser portofolio ke kiri"
          class="w-9 h-9 rounded-lg bg-devr-green hover:bg-devr-green-hover text-devr-green-text flex items-center justify-center font-bold transition-transform active:scale-95 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button
          type="button"
          id="port-next-btn"
          aria-label="Geser portofolio ke kanan"
          class="w-9 h-9 rounded-lg bg-devr-green hover:bg-devr-green-hover text-devr-green-text flex items-center justify-center font-bold transition-transform active:scale-95 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Scrollable Cards Container -->
    <div
      id="port-carousel"
      class="flex gap-5 overflow-x-auto no-scrollbar scroll-smooth pb-4 snap-x snap-mandatory"
    >
      <!-- Card 1: UMKM & Kuliner -->
      <div class="flex-none w-[300px] sm:w-[330px] md:w-[360px] snap-start rounded-xl overflow-hidden bg-devr-card border border-devr-border hover:border-devr-green/60 transition-all duration-300 flex flex-col group shadow-lg">
        <div class="relative h-48 overflow-hidden bg-devr-card">
          <img
            src="/assets/devr_showcase_cards.jpg"
            alt="Website UMKM, Toko & Kuliner"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80';"
          />
          <div class="absolute bottom-2 left-2 flex gap-1">
            <span class="bg-devr-card/90 backdrop-blur-md text-[10px] font-black text-devr-green px-2.5 py-0.5 rounded border border-devr-border shadow-sm">
              LANGSUNG ORDER
            </span>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] font-bold text-devr-green mb-1 tracking-wider uppercase">
              Produk &amp; Kuliner
            </div>
            <h3 class="text-lg font-extrabold text-devr-text-primary mb-2 group-hover:text-devr-green transition-colors leading-snug">
              Website UMKM, Toko &amp; Kuliner
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed font-normal">
              Tampilan katalog produk yang rapi dan menarik dengan tombol pesan langsung ke WhatsApp. Pembeli tinggal klik tanpa isi form rumit.
            </p>
          </div>
          <div class="pt-2 border-t border-devr-border/50 text-[11px] font-semibold text-devr-text-muted">
            Hasil: Pelanggan lebih cepat dan mudah memesan
          </div>
        </div>
      </div>

      <!-- Card 2: Layanan & Sewa -->
      <div class="flex-none w-[300px] sm:w-[330px] md:w-[360px] snap-start rounded-xl overflow-hidden bg-devr-card border border-devr-border hover:border-devr-green/60 transition-all duration-300 flex flex-col group shadow-lg">
        <div class="relative h-48 overflow-hidden bg-devr-card">
          <img
            src="/assets/devr_creator_studio.jpg"
            alt="Website Jasa, Rental & Klinik"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=800&q=80';"
          />
          <div class="absolute bottom-2 left-2 flex gap-1">
            <span class="bg-devr-card/90 backdrop-blur-md text-[10px] font-black text-devr-green px-2.5 py-0.5 rounded border border-devr-border shadow-sm">
              BOOKING CEPAT
            </span>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] font-bold text-devr-green mb-1 tracking-wider uppercase">
              Layanan &amp; Sewa
            </div>
            <h3 class="text-lg font-extrabold text-devr-text-primary mb-2 group-hover:text-devr-green transition-colors leading-snug">
              Website Jasa, Rental &amp; Klinik
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed font-normal">
              Tampilkan daftar layanan, harga, jadwal, hingga testimoni pelanggan untuk meyakinkan pengunjung langsung menghubungi Anda.
            </p>
          </div>
          <div class="pt-2 border-t border-devr-border/50 text-[11px] font-semibold text-devr-text-muted">
            Hasil: Jadwal pesanan dan konsultasi lebih ramai
          </div>
        </div>
      </div>

      <!-- Card 3: Promotion Pages -->
      <div class="flex-none w-[300px] sm:w-[330px] md:w-[360px] snap-start rounded-xl overflow-hidden bg-devr-card border border-devr-border hover:border-devr-green/60 transition-all duration-300 flex flex-col group shadow-lg">
        <div class="relative h-48 overflow-hidden bg-devr-card">
          <img
            src="/assets/devr_split_comparison.jpg"
            alt="Halaman Khusus Iklan & Promo"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80';"
          />
          <div class="absolute bottom-2 left-2 flex gap-1">
            <span class="bg-devr-card/90 backdrop-blur-md text-[10px] font-black text-devr-green px-2.5 py-0.5 rounded border border-devr-border shadow-sm">
              FOKUS JUALAN
            </span>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] font-bold text-devr-green mb-1 tracking-wider uppercase">
              Promosi &amp; Iklan
            </div>
            <h3 class="text-lg font-extrabold text-devr-text-primary mb-2 group-hover:text-devr-green transition-colors leading-snug">
              Halaman Khusus Iklan &amp; Promo
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed font-normal">
              Dilengkapi kalimat promosi yang menarik minat beli. Sangat cocok dipadukan dengan iklan Meta Ads, Google Ads, atau TikTok Ads.
            </p>
          </div>
          <div class="pt-2 border-t border-devr-border/50 text-[11px] font-semibold text-devr-text-muted">
            Hasil: Penjualan dari iklan meningkat lebih optimal
          </div>
        </div>
      </div>

      <!-- Card 4: Company Profile & B2B -->
      <div class="flex-none w-[300px] sm:w-[330px] md:w-[360px] snap-start rounded-xl overflow-hidden bg-devr-card border border-devr-border hover:border-devr-green/60 transition-all duration-300 flex flex-col group shadow-lg">
        <div class="relative h-48 overflow-hidden bg-devr-card">
          <img
            src="/assets/devr_hero_laptop.jpg"
            alt="Company Profile & Bisnis Skala Besar"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=800&q=80';"
          />
          <div class="absolute bottom-2 left-2 flex gap-1">
            <span class="bg-devr-card/90 backdrop-blur-md text-[10px] font-black text-devr-green px-2.5 py-0.5 rounded border border-devr-border shadow-sm">
              PROFESIONAL
            </span>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] font-bold text-devr-green mb-1 tracking-wider uppercase">
              Perusahaan &amp; B2B
            </div>
            <h3 class="text-lg font-extrabold text-devr-text-primary mb-2 group-hover:text-devr-green transition-colors leading-snug">
              Company Profile &amp; Bisnis Skala Besar
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed font-normal">
              Desain elegan dan terpercaya untuk meningkatkan reputasi perusahaan, memenangkan tender, dan menjaring kerja sama bisnis.
            </p>
          </div>
          <div class="pt-2 border-t border-devr-border/50 text-[11px] font-semibold text-devr-text-muted">
            Hasil: Bisnis terlihat lebih bonafide dan meyakinkan
          </div>
        </div>
      </div>
    </div>

    <!-- Progress Indicator Bar -->
    <div class="mt-4 w-full h-1 bg-devr-border rounded-full overflow-hidden relative">
      <div id="port-progress-bar" class="h-full bg-devr-green w-1/4 rounded-full transition-all duration-300"></div>
    </div>
  </div>
</section>

<script is:inline>
  const portContainer = document.getElementById('port-carousel');
  const portPrev = document.getElementById('port-prev-btn');
  const portNext = document.getElementById('port-next-btn');
  const portProgress = document.getElementById('port-progress-bar');

  if (portContainer && portPrev && portNext && portProgress) {
    const cardWidth = 360;

    portNext.addEventListener('click', () => {
      portContainer.scrollBy({ left: cardWidth, behavior: 'smooth' });
    });

    portPrev.addEventListener('click', () => {
      portContainer.scrollBy({ left: -cardWidth, behavior: 'smooth' });
    });

    portContainer.addEventListener('scroll', () => {
      const maxScroll = portContainer.scrollWidth - portContainer.clientWidth;
      if (maxScroll > 0) {
        const percentage = Math.min(100, Math.max(25, (portContainer.scrollLeft / maxScroll) * 100));
        portProgress.style.width = percentage + '%';
      }
    });
  }
</script>
