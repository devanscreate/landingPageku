---
// src/components/ProductivitySection.astro
---

<section id="fitur" class="py-14 bg-devr-bg border-b border-devr-border transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header: Title & Navigation Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div>
        <span class="text-xs uppercase font-extrabold tracking-widest text-devr-green block mb-1">
          KEMUDAHAN OPERASIONAL
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-devr-text-primary tracking-tight">
          FITUR LENGKAP UNTUK PERTUMBUHAN BISNIS
        </h2>
      </div>

      <!-- Navigation Arrows -->
      <div class="flex items-center space-x-2 self-end sm:self-auto">
        <button
          type="button"
          id="prod-prev-btn"
          aria-label="Geser ke kiri"
          class="w-9 h-9 rounded-lg bg-devr-green hover:bg-devr-green-hover text-devr-green-text flex items-center justify-center font-bold transition-transform active:scale-95 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button
          type="button"
          id="prod-next-btn"
          aria-label="Geser ke kanan"
          class="w-9 h-9 rounded-lg bg-devr-green hover:bg-devr-green-hover text-devr-green-text flex items-center justify-center font-bold transition-transform active:scale-95 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Scrollable Cards Container -->
    <div
      id="prod-carousel"
      class="flex gap-5 overflow-x-auto no-scrollbar scroll-smooth pb-4 snap-x snap-mandatory"
    >
      <!-- Card 1 -->
      <div class="flex-none w-[300px] sm:w-[330px] md:w-[360px] snap-start rounded-xl overflow-hidden bg-devr-card border border-devr-border hover:border-devr-green/60 transition-all duration-300 flex flex-col group shadow-lg">
        <div class="relative h-48 overflow-hidden bg-devr-card">
          <img
            src="/assets/devr_hero_laptop.jpg"
            alt="Kelola Konten Mudah"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=800&q=80';"
          />
          <div class="absolute bottom-2 left-2 flex gap-1">
            <span class="bg-devr-card/90 backdrop-blur-md text-[10px] font-black text-devr-green px-2.5 py-0.5 rounded border border-devr-border shadow-sm">
              MANDIRI &amp; MUDAH
            </span>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] font-bold text-devr-green mb-1 tracking-wider uppercase">
              Update Visual
            </div>
            <h3 class="text-lg font-extrabold text-devr-text-primary mb-2 group-hover:text-devr-green transition-colors leading-snug">
              Edit Konten &amp; Foto Kapan Saja
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed font-normal">
              Dilengkapi panel visual yang ramah pengguna. Anda dan tim dapat mengubah harga promo, testimoni, atau foto produk tanpa perlu bantuan developer.
            </p>
          </div>
          <div class="pt-2 border-t border-devr-border/50 text-[11px] font-semibold text-devr-text-muted">
            ✓ Panduan video &amp; tutorial siap pakai
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="flex-none w-[300px] sm:w-[330px] md:w-[360px] snap-start rounded-xl overflow-hidden bg-devr-card border border-devr-border hover:border-devr-green/60 transition-all duration-300 flex flex-col group shadow-lg">
        <div class="relative h-48 overflow-hidden bg-devr-card">
          <img
            src="/assets/devr_creator_studio.jpg"
            alt="Arsitektur Modern Skor 100"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=800&q=80';"
          />
          <div class="absolute bottom-2 left-2 flex gap-1">
            <span class="bg-devr-card/90 backdrop-blur-md text-[10px] font-black text-devr-green px-2.5 py-0.5 rounded border border-devr-border shadow-sm">
              SCORE 100
            </span>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] font-bold text-devr-green mb-1 tracking-wider uppercase">
              Arsitektur Web
            </div>
            <h3 class="text-lg font-extrabold text-devr-text-primary mb-2 group-hover:text-devr-green transition-colors leading-snug">
              Arsitektur Statis Berkecepatan Tinggi
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed font-normal">
              Kombinasi modern Astro.js dan Tailwind CSS menghasilkan skor Google Lighthouse 100/100 demi visibilitas organik maksimal di mesin pencari.
            </p>
          </div>
          <div class="pt-2 border-t border-devr-border/50 text-[11px] font-semibold text-devr-text-muted">
            ✓ SEO semantik &amp; Google Core Web Vitals hijau
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="flex-none w-[300px] sm:w-[330px] md:w-[360px] snap-start rounded-xl overflow-hidden bg-devr-card border border-devr-border hover:border-devr-green/60 transition-all duration-300 flex flex-col group shadow-lg">
        <div class="relative h-48 overflow-hidden bg-devr-card">
          <img
            src="/assets/devr_split_comparison.jpg"
            alt="Integrasi WhatsApp & Form Lead"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1577563908411-5077b6dc7624?auto=format&fit=crop&w=800&q=80';"
          />
          <div class="absolute bottom-2 left-2 flex gap-1">
            <span class="bg-devr-card/90 backdrop-blur-md text-[10px] font-black text-devr-green px-2.5 py-0.5 rounded border border-devr-border shadow-sm">
              AUTO LEAD
            </span>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] font-bold text-devr-green mb-1 tracking-wider uppercase">
              Otomasi Prospek
            </div>
            <h3 class="text-lg font-extrabold text-devr-text-primary mb-2 group-hover:text-devr-green transition-colors leading-snug">
              Integrasi WhatsApp &amp; Form Lead
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed font-normal">
              Ubah setiap klik pengunjung menjadi percakapan langsung ke WhatsApp bisnis Anda, email, atau CRM tanpa biaya operasional server.
            </p>
          </div>
          <div class="pt-2 border-t border-devr-border/50 text-[11px] font-semibold text-devr-text-muted">
            ✓ Template pesan WhatsApp otomatis tersusun rapi
          </div>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="flex-none w-[300px] sm:w-[330px] md:w-[360px] snap-start rounded-xl overflow-hidden bg-devr-card border border-devr-border hover:border-devr-green/60 transition-all duration-300 flex flex-col group shadow-lg">
        <div class="relative h-48 overflow-hidden bg-devr-card">
          <img
            src="/assets/devr_showcase_cards.jpg"
            alt="Hosting Gratis Cloudflare Pages"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=800&q=80';"
          />
          <div class="absolute bottom-2 left-2 flex gap-1">
            <span class="bg-devr-card/90 backdrop-blur-md text-[10px] font-black text-devr-green px-2.5 py-0.5 rounded border border-devr-border shadow-sm">
              ZERO MAINTENANCE
            </span>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] font-bold text-devr-green mb-1 tracking-wider uppercase">
              Infrastruktur Cloud
            </div>
            <h3 class="text-lg font-extrabold text-devr-text-primary mb-2 group-hover:text-devr-green transition-colors leading-snug">
              Hosting Selamanya Gratis di Cloudflare
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed font-normal">
              Keamanan tingkat bank, proteksi serangan siber DDoS, dan CDN edge tercepat di dunia tanpa biaya server bulanan seumur hidup.
            </p>
          </div>
          <div class="pt-2 border-t border-devr-border/50 text-[11px] font-semibold text-devr-text-muted">
            ✓ 99.99% Uptime global dengan proteksi SSL otomatis
          </div>
        </div>
      </div>
    </div>

    <!-- Progress Indicator Bar -->
    <div class="mt-4 w-full h-1 bg-devr-border rounded-full overflow-hidden relative">
      <div id="prod-progress-bar" class="h-full bg-devr-green w-1/4 rounded-full transition-all duration-300"></div>
    </div>
  </div>
</section>

<script is:inline>
  const prodContainer = document.getElementById('prod-carousel');
  const prodPrev = document.getElementById('prod-prev-btn');
  const prodNext = document.getElementById('prod-next-btn');
  const prodProgress = document.getElementById('prod-progress-bar');

  if (prodContainer && prodPrev && prodNext && prodProgress) {
    const cardWidth = 360;

    prodNext.addEventListener('click', () => {
      prodContainer.scrollBy({ left: cardWidth, behavior: 'smooth' });
    });

    prodPrev.addEventListener('click', () => {
      prodContainer.scrollBy({ left: -cardWidth, behavior: 'smooth' });
    });

    prodContainer.addEventListener('scroll', () => {
      const maxScroll = prodContainer.scrollWidth - prodContainer.clientWidth;
      if (maxScroll > 0) {
        const percentage = Math.min(100, Math.max(25, (prodContainer.scrollLeft / maxScroll) * 100));
        prodProgress.style.width = percentage + '%';
      }
    });
  }
</script>
