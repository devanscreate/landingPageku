---
// src/components/TechSection.astro
---

<section id="penawaran" class="py-14 bg-devr-bg border-b border-devr-border transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header: Title & Navigation Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div>
        <span class="text-xs uppercase font-extrabold tracking-widest text-devr-green block mb-1">
          NILAI &amp; SOLUSI NYATA
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-devr-text-primary tracking-tight">
          MENGAPA BISNIS ANDA BUTUH DEVR STUDIO?
        </h2>
      </div>

      <!-- Navigation Arrows -->
      <div class="flex items-center space-x-2 self-end sm:self-auto">
        <button
          type="button"
          id="tech-prev-btn"
          aria-label="Geser ke kiri"
          class="w-9 h-9 rounded-lg bg-devr-green hover:bg-devr-green-hover text-devr-green-text flex items-center justify-center font-bold transition-transform active:scale-95 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button
          type="button"
          id="tech-next-btn"
          aria-label="Geser ke kanan"
          class="w-9 h-9 rounded-lg bg-devr-green hover:bg-devr-green-hover text-devr-green-text flex items-center justify-center font-bold transition-transform active:scale-95 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Scrollable Cards Container (Carousel) -->
    <div
      id="tech-carousel"
      class="flex gap-5 overflow-x-auto no-scrollbar scroll-smooth pb-4 snap-x snap-mandatory"
    >
      <!-- Card 1: Initial UI Preview -->
      <div class="flex-none w-[300px] sm:w-[330px] md:w-[360px] snap-start rounded-xl overflow-hidden bg-devr-card border border-devr-border hover:border-devr-green/60 transition-all duration-300 flex flex-col group shadow-lg">
        <div class="relative h-48 overflow-hidden bg-devr-card">
          <img
            src="/assets/devr_creator_studio.jpg"
            alt="Preview UI Awal DEVR Studio"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=800&q=80';"
          />
          <div class="absolute bottom-2 left-2 flex gap-1">
            <span class="bg-devr-card/90 backdrop-blur-md text-[10px] font-black text-devr-green px-2.5 py-0.5 rounded border border-devr-border shadow-sm">
              BEBAS RISIKO
            </span>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] font-bold text-devr-green mb-1 tracking-wider uppercase">
              Kepastian Visual
            </div>
            <h3 class="text-lg font-extrabold text-devr-text-primary mb-2 group-hover:text-devr-green transition-colors leading-snug">
              Preview UI Awal (Lihat Dulu Sebelum Dibangun)
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed font-normal">
              Khawatir hasil akhir tidak sesuai ekspektasi? Kami buatkan konsep visual UI awal khusus bisnis Anda. Anda mendapatkan gambaran konkret sebelum proses coding resmi berjalan.
            </p>
          </div>
          <div class="pt-2 border-t border-devr-border/50 text-[11px] font-semibold text-devr-text-muted">
            ✓ Konsultasi arah desain tanpa komitmen awal
          </div>
        </div>
      </div>

      <!-- Card 2: Revisions Guaranteed -->
      <div class="flex-none w-[300px] sm:w-[330px] md:w-[360px] snap-start rounded-xl overflow-hidden bg-devr-card border border-devr-border hover:border-devr-green/60 transition-all duration-300 flex flex-col group shadow-lg">
        <div class="relative h-48 overflow-hidden bg-devr-card">
          <img
            src="/assets/devr_split_comparison.jpg"
            alt="Garansi Revisi Fleksibel"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80';"
          />
          <div class="absolute bottom-2 left-2 flex gap-1">
            <span class="bg-devr-card/90 backdrop-blur-md text-[10px] font-black text-devr-text-muted px-2 py-0.5 rounded border border-devr-border shadow-sm">
              KLIEN RAGU
            </span>
            <span class="bg-devr-green text-[10px] font-black text-devr-green-text px-2 py-0.5 rounded shadow-sm">
              DIJAMIN COCOK
            </span>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] font-bold text-devr-green mb-1 tracking-wider uppercase">
              Jaminan Kepuasan
            </div>
            <h3 class="text-lg font-extrabold text-devr-text-primary mb-2 group-hover:text-devr-green transition-colors leading-snug">
              Garansi Revisi Pasti &amp; Terbuka
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed font-normal">
              Jangan ragu meminta perbaikan tampilan. Setiap proyek hadir dengan fleksibilitas revisi yang jelas. Belum pas dengan warna, teks, atau penempatan elemen? Kami sempurnakan hingga Anda puas.
            </p>
          </div>
          <div class="pt-2 border-t border-devr-border/50 text-[11px] font-semibold text-devr-text-muted">
            ✓ Kolaborasi interaktif sampai sesuai selera
          </div>
        </div>
      </div>

      <!-- Card 3: Lightning Speed -->
      <div class="flex-none w-[300px] sm:w-[330px] md:w-[360px] snap-start rounded-xl overflow-hidden bg-devr-card border border-devr-border hover:border-devr-green/60 transition-all duration-300 flex flex-col group shadow-lg">
        <div class="relative h-48 overflow-hidden bg-devr-card">
          <img
            src="/assets/devr_showcase_cards.jpg"
            alt="Loading Kilat Kurang Dari 1 Detik"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&q=80';"
          />
          <div class="absolute bottom-2 left-2 flex gap-1">
            <span class="bg-devr-card/90 backdrop-blur-md text-[10px] font-black text-devr-green px-2.5 py-0.5 rounded border border-devr-border shadow-sm">
              SPEED &lt; 1s
            </span>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] font-bold text-devr-green mb-1 tracking-wider uppercase">
              Performa Konversi
            </div>
            <h3 class="text-lg font-extrabold text-devr-text-primary mb-2 group-hover:text-devr-green transition-colors leading-snug">
              Loading Kilat (&lt; 1 Detik)
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed font-normal">
              Website yang lemot membuang calon pelanggan dan membakar anggaran iklan Anda. Halaman kami dibangun ultra-ringan, terbuka seketika bahkan saat pengunjung mengakses dengan sinyal ponsel lemah.
            </p>
          </div>
          <div class="pt-2 border-t border-devr-border/50 text-[11px] font-semibold text-devr-text-muted">
            ✓ Efisiensi budget iklan FB/TikTok/Google Ads
          </div>
        </div>
      </div>

      <!-- Card 4: One-time payment, free hosting -->
      <div class="flex-none w-[300px] sm:w-[330px] md:w-[360px] snap-start rounded-xl overflow-hidden bg-devr-card border border-devr-border hover:border-devr-green/60 transition-all duration-300 flex flex-col group shadow-lg">
        <div class="relative h-48 overflow-hidden bg-devr-card">
          <img
            src="/assets/devr_hero_laptop.jpg"
            alt="Hosting Gratis Selamanya"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=800&q=80';"
          />
          <div class="absolute bottom-2 left-2 flex gap-1">
            <span class="bg-devr-card/90 backdrop-blur-md text-[10px] font-black text-devr-green px-2.5 py-0.5 rounded border border-devr-border shadow-sm">
              HEMAT JUTAAN
            </span>
          </div>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] font-bold text-devr-green mb-1 tracking-wider uppercase">
              Bebas Beban Rutin
            </div>
            <h3 class="text-lg font-extrabold text-devr-text-primary mb-2 group-hover:text-devr-green transition-colors leading-snug">
              Bayar Sekali, Gratis Hosting Selamanya
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed font-normal">
              Stop bayar biaya sewa server jutaan rupiah tiap tahun. Berkat teknologi edge modern, website Anda aktif 24/7 dengan keamanan tier-1 tanpa ada tagihan hosting bulanan yang mencekik.
            </p>
          </div>
          <div class="pt-2 border-t border-devr-border/50 text-[11px] font-semibold text-devr-text-muted">
            ✓ Bebas cemas website mati karena lupa perpanjang hosting
          </div>
        </div>
      </div>
    </div>

    <!-- Progress Indicator Bar -->
    <div class="mt-4 w-full h-1 bg-devr-border rounded-full overflow-hidden relative">
      <div id="tech-progress-bar" class="h-full bg-devr-green w-1/4 rounded-full transition-all duration-300"></div>
    </div>
  </div>
</section>

<script is:inline>
  // Tech Carousel Navigation & Dynamic Progress Bar
  const techContainer = document.getElementById('tech-carousel');
  const techPrev = document.getElementById('tech-prev-btn');
  const techNext = document.getElementById('tech-next-btn');
  const techProgress = document.getElementById('tech-progress-bar');

  if (techContainer && techPrev && techNext && techProgress) {
    const cardWidth = 360;

    techNext.addEventListener('click', () => {
      techContainer.scrollBy({ left: cardWidth, behavior: 'smooth' });
    });

    techPrev.addEventListener('click', () => {
      techContainer.scrollBy({ left: -cardWidth, behavior: 'smooth' });
    });

    techContainer.addEventListener('scroll', () => {
      const maxScroll = techContainer.scrollWidth - techContainer.clientWidth;
      if (maxScroll > 0) {
        const percentage = Math.min(100, Math.max(25, (techContainer.scrollLeft / maxScroll) * 100));
        techProgress.style.width = percentage + '%';
      }
    });
  }
</script>
