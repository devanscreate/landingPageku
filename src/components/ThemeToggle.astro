---
// src/components/ThemeToggle.astro
---

<div class="relative inline-block text-left" id="theme-menu-container">
  <button
    id="theme-toggle-btn"
    type="button"
    aria-label="Ubah Tema"
    class="flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded border border-devr-border bg-devr-card hover:border-devr-green text-devr-text-secondary hover:text-devr-text-primary transition-all duration-200"
  >
    <svg id="theme-icon-dark" class="w-3.5 h-3.5 text-devr-green hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.03 9.03 0 008.354-5.646z" />
    </svg>
    <svg id="theme-icon-light" class="w-3.5 h-3.5 text-amber-500 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    <svg id="theme-icon-stealth" class="w-3.5 h-3.5 text-emerald-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
    </svg>
    <span id="theme-label" class="capitalize">Tema</span>
    <svg class="w-3 h-3 ml-0.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    id="theme-dropdown"
    class="hidden absolute right-0 mt-1.5 w-40 rounded shadow-xl bg-devr-card border border-devr-border py-1 z-50 transition-all duration-150"
  >
    <button
      type="button"
      data-set-theme="dark"
      class="w-full text-left px-3 py-1.5 text-xs flex items-center justify-between text-devr-text-secondary hover:text-white hover:bg-devr-card-hover transition-colors"
    >
      <span class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[#76B900]"></span>
        DEVR Dark (NVIDIA)
      </span>
      <span class="theme-check text-devr-green hidden">✓</span>
    </button>
    <button
      type="button"
      data-set-theme="light"
      class="w-full text-left px-3 py-1.5 text-xs flex items-center justify-between text-devr-text-secondary hover:text-white hover:bg-devr-card-hover transition-colors"
    >
      <span class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-slate-300 border border-slate-400"></span>
        Light Mode
      </span>
      <span class="theme-check text-devr-green hidden">✓</span>
    </button>
    <button
      type="button"
      data-set-theme="stealth"
      class="w-full text-left px-3 py-1.5 text-xs flex items-center justify-between text-devr-text-secondary hover:text-white hover:bg-devr-card-hover transition-colors"
    >
      <span class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
        Emerald Stealth
      </span>
      <span class="theme-check text-devr-green hidden">✓</span>
    </button>
  </div>
</div>

<script is:inline>
  // Pure Vanilla JS Theme Engine (Zero dependencies, instant execution)
  (function initTheme() {
    const savedTheme = localStorage.getItem('devr-theme') || 'dark';
    applyTheme(savedTheme);

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('devr-theme', theme);

      const label = document.getElementById('theme-label');
      const iconDark = document.getElementById('theme-icon-dark');
      const iconLight = document.getElementById('theme-icon-light');
      const iconStealth = document.getElementById('theme-icon-stealth');

      if (iconDark && iconLight && iconStealth && label) {
        iconDark.classList.add('hidden');
        iconLight.classList.add('hidden');
        iconStealth.classList.add('hidden');

        if (theme === 'light') {
          iconLight.classList.remove('hidden');
          label.textContent = 'Light';
        } else if (theme === 'stealth') {
          iconStealth.classList.remove('hidden');
          label.textContent = 'Stealth';
        } else {
          iconDark.classList.remove('hidden');
          label.textContent = 'NVIDIA';
        }
      }

      // Update checkmarks in dropdown
      document.querySelectorAll('#theme-dropdown button').forEach((btn) => {
        const isCurrent = btn.getAttribute('data-set-theme') === theme;
        const check = btn.querySelector('.theme-check');
        if (check) {
          check.classList.toggle('hidden', !isCurrent);
        }
      });
    }

    // Toggle dropdown
    const btn = document.getElementById('theme-toggle-btn');
    const dropdown = document.getElementById('theme-dropdown');

    if (btn && dropdown) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('hidden');
      });

      document.addEventListener('click', () => {
        dropdown.classList.add('hidden');
      });

      dropdown.querySelectorAll('[data-set-theme]').forEach((option) => {
        option.addEventListener('click', (e) => {
          e.stopPropagation();
          const targetTheme = option.getAttribute('data-set-theme');
          if (targetTheme) {
            applyTheme(targetTheme);
          }
          dropdown.classList.add('hidden');
        });
      });
    }
  })();
</script>
