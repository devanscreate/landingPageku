---
// src/components/ThemeToggle.astro
---

<div class="relative inline-block text-left" id="theme-menu-container">
  <button
    id="theme-toggle-btn"
    type="button"
    aria-label="Ubah Tema Warna"
    class="flex items-center gap-2 px-2.5 py-1 text-xs font-semibold rounded border border-devr-border bg-devr-card hover:border-devr-green text-devr-text-secondary hover:text-devr-text-primary transition-all duration-200"
  >
    <span id="theme-active-dot" class="w-2.5 h-2.5 rounded-full bg-devr-green transition-colors"></span>
    <span id="theme-label" class="capitalize">Tema</span>
    <svg class="w-3 h-3 ml-0.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    id="theme-dropdown"
    class="hidden absolute right-0 mt-2 w-48 rounded-lg shadow-2xl bg-devr-card border border-devr-border py-1.5 z-50 transition-all duration-150 backdrop-blur-md"
  >
    <div class="px-3 py-1 text-[10px] uppercase font-bold tracking-wider text-devr-text-muted border-b border-devr-border/60 mb-1">
      Pilih Tema Warna
    </div>

    <button
      type="button"
      data-set-theme="dark"
      data-color="#76B900"
      data-label="DEVR Green"
      class="w-full text-left px-3 py-1.5 text-xs flex items-center justify-between text-devr-text-secondary hover:text-white hover:bg-devr-card-hover transition-colors"
    >
      <span class="flex items-center gap-2.5">
        <span class="w-3 h-3 rounded-full bg-[#76B900] shadow-sm"></span>
        DEVR Green (Default)
      </span>
      <span class="theme-check text-devr-green hidden font-bold">✓</span>
    </button>

    <button
      type="button"
      data-set-theme="cyber"
      data-color="#00D8F6"
      data-label="Cyber Cyan"
      class="w-full text-left px-3 py-1.5 text-xs flex items-center justify-between text-devr-text-secondary hover:text-white hover:bg-devr-card-hover transition-colors"
    >
      <span class="flex items-center gap-2.5">
        <span class="w-3 h-3 rounded-full bg-[#00D8F6] shadow-sm"></span>
        Cyber Cyan
      </span>
      <span class="theme-check text-devr-green hidden font-bold">✓</span>
    </button>

    <button
      type="button"
      data-set-theme="amber"
      data-color="#F59E0B"
      data-label="Royal Amber"
      class="w-full text-left px-3 py-1.5 text-xs flex items-center justify-between text-devr-text-secondary hover:text-white hover:bg-devr-card-hover transition-colors"
    >
      <span class="flex items-center gap-2.5">
        <span class="w-3 h-3 rounded-full bg-[#F59E0B] shadow-sm"></span>
        Royal Amber
      </span>
      <span class="theme-check text-devr-green hidden font-bold">✓</span>
    </button>

    <button
      type="button"
      data-set-theme="crimson"
      data-color="#FF334B"
      data-label="Crimson Red"
      class="w-full text-left px-3 py-1.5 text-xs flex items-center justify-between text-devr-text-secondary hover:text-white hover:bg-devr-card-hover transition-colors"
    >
      <span class="flex items-center gap-2.5">
        <span class="w-3 h-3 rounded-full bg-[#FF334B] shadow-sm"></span>
        Crimson Red
      </span>
      <span class="theme-check text-devr-green hidden font-bold">✓</span>
    </button>

    <button
      type="button"
      data-set-theme="stealth"
      data-color="#00E676"
      data-label="Emerald Tech"
      class="w-full text-left px-3 py-1.5 text-xs flex items-center justify-between text-devr-text-secondary hover:text-white hover:bg-devr-card-hover transition-colors"
    >
      <span class="flex items-center gap-2.5">
        <span class="w-3 h-3 rounded-full bg-[#00E676] shadow-sm"></span>
        Emerald Tech
      </span>
      <span class="theme-check text-devr-green hidden font-bold">✓</span>
    </button>

    <button
      type="button"
      data-set-theme="monochrome"
      data-color="#E2E8F0"
      data-label="Platinum Mono"
      class="w-full text-left px-3 py-1.5 text-xs flex items-center justify-between text-devr-text-secondary hover:text-white hover:bg-devr-card-hover transition-colors"
    >
      <span class="flex items-center gap-2.5">
        <span class="w-3 h-3 rounded-full bg-[#E2E8F0] shadow-sm"></span>
        Platinum Mono
      </span>
      <span class="theme-check text-devr-green hidden font-bold">✓</span>
    </button>

    <div class="my-1 border-t border-devr-border/60"></div>

    <button
      type="button"
      data-set-theme="light"
      data-color="#68A500"
      data-label="Studio Light"
      class="w-full text-left px-3 py-1.5 text-xs flex items-center justify-between text-devr-text-secondary hover:text-white hover:bg-devr-card-hover transition-colors"
    >
      <span class="flex items-center gap-2.5">
        <span class="w-3 h-3 rounded-full bg-slate-200 border border-slate-400 shadow-sm"></span>
        Studio Light
      </span>
      <span class="theme-check text-devr-green hidden font-bold">✓</span>
    </button>
  </div>
</div>

<script is:inline>
  // Pure Vanilla JS Multi-Theme Engine
  (function initTheme() {
    const themeNames = {
      dark: { name: 'DEVR Green', color: '#76B900' },
      cyber: { name: 'Cyber Cyan', color: '#00D8F6' },
      amber: { name: 'Royal Amber', color: '#F59E0B' },
      crimson: { name: 'Crimson Red', color: '#FF334B' },
      stealth: { name: 'Emerald Tech', color: '#00E676' },
      monochrome: { name: 'Platinum Mono', color: '#E2E8F0' },
      light: { name: 'Light', color: '#68A500' }
    };

    const savedTheme = localStorage.getItem('devr-theme') || 'dark';
    applyTheme(savedTheme);

    function applyTheme(theme) {
      if (!themeNames[theme]) {
        theme = 'dark';
      }
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('devr-theme', theme);

      const label = document.getElementById('theme-label');
      const dot = document.getElementById('theme-active-dot');

      if (label && dot && themeNames[theme]) {
        label.textContent = themeNames[theme].name;
        dot.style.backgroundColor = themeNames[theme].color;
      }

      // Update checkmarks in dropdown
      document.querySelectorAll('#theme-dropdown button').forEach((btn) => {
        const isCurrent = btn.getAttribute('data-set-theme') === theme;
        const check = btn.querySelector('.theme-check');
        if (check) {
          check.classList.toggle('hidden', !isCurrent);
        }
      });
    }

    // Toggle dropdown
    const btn = document.getElementById('theme-toggle-btn');
    const dropdown = document.getElementById('theme-dropdown');

    if (btn && dropdown) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('hidden');
      });

      document.addEventListener('click', () => {
        dropdown.classList.add('hidden');
      });

      dropdown.querySelectorAll('[data-set-theme]').forEach((option) => {
        option.addEventListener('click', (e) => {
          e.stopPropagation();
          const targetTheme = option.getAttribute('data-set-theme');
          if (targetTheme) {
            applyTheme(targetTheme);
          }
          dropdown.classList.add('hidden');
        });
      });
    }
  })();
</script>
