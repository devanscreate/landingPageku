---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TechSection from '../components/TechSection.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import ProductivitySection from '../components/ProductivitySection.astro';
---

<Layout
  title="DEVR Studio - Ubah Pengunjung Jadi Pembeli dengan Landing Page Kustom"
  description="DEVR Studio menghadirkan landing page kustom berkecepatan tinggi dengan garansi revisi, preview desain UI awal gratis sebelum bayar, dan tanpa biaya langganan hosting bulanan."
>
  <!-- Hero Section: Headline Psikologis, Preview UI CTA & Quick Advantages Row -->
  <Hero />

  <!-- Section 1: Nilai & Solusi (Mengapa Bisnis Anda Butuh DEVR Studio) -->
  <TechSection />

  <!-- Section 2: 3 Langkah Mudah Memiliki Website Impian (How It Works) -->
  <HowItWorksSection />

  <!-- Section 3: Portofolio Solusi Bisnis Riil (UMKM, B2B, Promosi Produk) -->
  <PortfolioSection />

  <!-- Section 4: Fitur Operasional & Pertumbuhan Bisnis -->
  <ProductivitySection />

  <!-- Section 5: Paket & Penawaran -->
  <section id="penawaran" class="py-16 bg-devr-bg border-t border-b border-devr-border relative overflow-hidden transition-colors scroll-mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
        <span class="inline-block px-3 py-1 rounded-full bg-devr-card border border-devr-border text-devr-green font-mono text-xs font-bold uppercase tracking-wider">
          PAKET &amp; PENAWARAN
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-devr-text-primary tracking-tight">
          PILIH PAKET SESUAI <br class="hidden sm:inline" />
          <span class="text-devr-green">KEBUTUHAN USAHA ANDA</span>
        </h2>
        <p class="text-sm sm:text-base text-devr-text-secondary leading-relaxed">
          Investasi sekali bayar untuk jangka panjang. Tanpa biaya bulanan tersembunyi.
        </p>
      </div>

      <!-- Pricing / Package Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <!-- Package 1: Starter UMKM -->
        <div class="rounded-2xl bg-devr-card border border-devr-border p-6 sm:p-7 flex flex-col justify-between hover:border-devr-green/60 transition-all duration-300 group shadow-lg">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-extrabold uppercase tracking-wider text-devr-text-muted">Starter</span>
              <span class="text-[11px] font-bold text-devr-green bg-devr-green/10 px-2 py-0.5 rounded border border-devr-green/20">Hemat Biaya</span>
            </div>
            <h3 class="text-xl font-extrabold text-devr-text-primary group-hover:text-devr-green transition-colors">
              Website Usaha &amp; UMKM
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed">
              Pilihan hemat untuk usaha baru, kuliner, atau jasa lokal yang ingin cepat punya halaman promosi dan tombol order WhatsApp.
            </p>
            <div class="pt-2 border-t border-devr-border/60 space-y-2.5 text-xs text-devr-text-secondary">
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span>Desain 1 Halaman Rapi (HP &amp; Laptop)</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span>Tombol Chat Langsung ke WhatsApp</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span>Garansi Revisi Sampai Pas</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span>Gratis Hosting Selamanya</span>
              </div>
            </div>
          </div>
          <div class="pt-6">
            <a
              href="https://wa.me/"
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center py-2.5 text-xs font-bold text-devr-text-primary bg-devr-card border border-devr-border hover:border-devr-green hover:text-devr-green rounded-lg transition-colors"
            >
              Pilih Paket Starter
            </a>
          </div>
        </div>

        <!-- Package 2: Bisnis Pro (Unggulan) -->
        <div class="rounded-2xl bg-devr-card border-2 border-devr-green p-6 sm:p-7 flex flex-col justify-between relative shadow-xl transform md:-translate-y-2 transition-all duration-300 group">
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-devr-green text-devr-green-text text-[10px] font-black uppercase px-3 py-1 rounded-full tracking-wider shadow-sm">
            PALING DIMINATI
          </div>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-extrabold uppercase tracking-wider text-devr-green">Bisnis Pro</span>
              <span class="text-[11px] font-bold text-devr-green-text bg-devr-green px-2 py-0.5 rounded">Paling Diminati</span>
            </div>
            <h3 class="text-xl font-extrabold text-devr-text-primary group-hover:text-devr-green transition-colors">
              Fokus Jualan &amp; Iklan
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed">
              Cocok untuk usaha yang ingin meningkatkan omzet dan memaksimalkan hasil iklan di Facebook, Instagram, TikTok, atau Google.
            </p>
            <div class="pt-2 border-t border-devr-border/60 space-y-2.5 text-xs text-devr-text-secondary">
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span><strong>Gratis Desain Awal Sebelum Bayar</strong></span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span>Dibantu Susun Kalimat Promosi Menarik</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span>Buka Web &lt; 1 Detik &amp; Mudah Dicari di Google</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span>Pasang Pixel Iklan &amp; Tombol Pesan Cepat</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span>Garansi Revisi Penuh Sampai Puas</span>
              </div>
            </div>
          </div>
          <div class="pt-6">
            <a
              href="https://wa.me/"
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center py-2.5 text-xs font-bold text-devr-green-text bg-devr-green hover:bg-devr-green-hover rounded-lg transition-colors shadow-md shadow-devr-green/20"
            >
              Minta Desain Gratis (Bisnis Pro)
            </a>
          </div>
        </div>

        <!-- Package 3: Custom B2B & Corporate -->
        <div class="rounded-2xl bg-devr-card border border-devr-border p-6 sm:p-7 flex flex-col justify-between hover:border-devr-green/60 transition-all duration-300 group shadow-lg">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-extrabold uppercase tracking-wider text-devr-text-muted">Enterprise</span>
              <span class="text-[11px] font-bold text-devr-text-primary bg-devr-card-hover px-2 py-0.5 rounded border border-devr-border">Kustom Penuh</span>
            </div>
            <h3 class="text-xl font-extrabold text-devr-text-primary group-hover:text-devr-green transition-colors">
              Company Profile &amp; Perusahaan
            </h3>
            <p class="text-xs text-devr-text-secondary leading-relaxed">
              Solusi lengkap untuk PT, CV, kontraktor, atau instansi yang membutuhkan profil perusahaan resmi dan formulir penawaran.
            </p>
            <div class="pt-2 border-t border-devr-border/60 space-y-2.5 text-xs text-devr-text-secondary">
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span>Halaman Lengkap Sesuai Kebutuhan Perusahaan</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span>Formulir Permintaan Penawaran Resmi</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span>Gratis Domain (.com/.id) &amp; Keamanan SSL</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-devr-green font-bold">✓</span>
                <span>Diskusi Konsep Langsung 1-on-1</span>
              </div>
            </div>
          </div>
          <div class="pt-6">
            <a
              href="https://wa.me/"
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center py-2.5 text-xs font-bold text-devr-text-primary bg-devr-card border border-devr-border hover:border-devr-green hover:text-devr-green rounded-lg transition-colors"
            >
              Konsultasi Paket Perusahaan
            </a>
          </div>
        </div>
      </div>

      <!-- Action Banner / Conversion CTA Card -->
      <div class="rounded-2xl bg-devr-card border border-devr-border p-8 sm:p-12 text-center shadow-xl relative overflow-hidden">
        <div class="absolute inset-0 pointer-events-none opacity-15">
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-48 bg-devr-green blur-[120px] rounded-full"></div>
        </div>

        <div class="relative z-10 space-y-6">
          <span class="inline-block px-3 py-1 rounded-full bg-devr-badge border border-devr-border text-devr-green font-mono text-xs font-bold uppercase tracking-wider">
            KONSULTASI GRATIS &amp; BEBAS RISIKO
          </span>

          <h3 class="text-2xl sm:text-3xl md:text-4xl font-black text-devr-text-primary tracking-tight">
            LIHAT CONTOH DESAIN WEBSITE USAHA ANDA SEKARANG
          </h3>

          <p class="text-sm sm:text-base text-devr-text-secondary max-w-2xl mx-auto leading-relaxed">
            Tidak perlu bayar di depan. Ceritakan usaha Anda, dan kami buatkan konsep tampilannya dulu secara gratis. Cocok dengan hasilnya? Baru kita lanjutkan.
          </p>

          <div class="pt-4 flex flex-wrap justify-center gap-4">
            <a
              href="https://wa.me/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-3.5 text-sm font-bold text-devr-green-text bg-devr-green hover:bg-devr-green-hover rounded-lg transition-all duration-200 transform hover:scale-105 shadow-xl shadow-devr-green/20"
            >
              Konsultasi &amp; Minta Desain Gratis via WhatsApp &rarr;
            </a>
            <a
              href="/portofolio"
              class="px-8 py-3.5 text-sm font-semibold text-devr-text-primary border border-devr-border hover:border-devr-green hover:bg-devr-card-hover rounded-lg transition-all duration-200"
            >
              Lihat Contoh Karya
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
