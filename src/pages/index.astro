---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TechSection from '../components/TechSection.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import ProductivitySection from '../components/ProductivitySection.astro';
---

<Layout
  title="DEVR - Solusi Landing Page Kustom Berkecepatan Tinggi"
  description="DEVR menghadirkan landing page kustom eksklusif dengan arsitektur Astro.js dan Tailwind CSS. Tanpa batasan template, skor kecepatan maksimal, dan siap melipatgandakan konversi bisnis Anda."
>
  <!-- Hero Section with RTX Unfolding Showcase & Bottom Tabs -->
  <Hero />

  <!-- Section 1: Teknologi DEVR (Matches 'Teknologi RTX' Carousel) -->
  <TechSection />

  <!-- Section 2: Portofolio & Solusi Web (Matches 'Game' Section) -->
  <PortfolioSection />

  <!-- Section 3: Berkreasi dan Produktivitas (Matches 'Berkreasi dan Produktivitas') -->
  <ProductivitySection />

  <!-- Action Banner / Conversion CTA (Matches NVIDIA Pro Showcase Banner) -->
  <section class="py-16 bg-gradient-to-r from-[#000000] via-[#0c120a] to-[#000000] border-t border-b border-devr-border relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none opacity-20">
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-64 bg-devr-green/30 blur-[140px] rounded-full"></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-6">
      <span class="inline-block px-3 py-1 rounded bg-devr-badge border border-devr-green/40 text-devr-green font-mono text-xs font-bold uppercase tracking-wider">
        Mulai Proyek Anda Bersama DEVR
      </span>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        Dapatkan Landing Page Kustom <br class="hidden sm:inline" />
        <span class="text-devr-green">Dengan Performa &amp; Konversi Tertinggi</span>
      </h2>

      <p class="text-sm sm:text-base text-devr-text-secondary max-w-2xl mx-auto leading-relaxed">
        Tanpa template pasaran. Tanpa langganan hosting bulanan yang mahal. Dibangun dengan standar rekayasa modern untuk hasil bisnis yang nyata.
      </p>

      <div class="pt-4 flex flex-wrap justify-center gap-4">
        <a
          href="https://wa.me/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-3 text-sm font-bold text-black bg-devr-green hover:bg-devr-green-hover rounded transition-all duration-200 transform hover:scale-105 shadow-lg shadow-devr-green/20"
        >
          Konsultasi Gratis Sekarang
        </a>
        <a
          href="#teknologi"
          class="px-8 py-3 text-sm font-semibold text-white border border-devr-border hover:border-devr-green hover:bg-devr-card rounded transition-all duration-200"
        >
          Pelajari Spesifikasi Teknis
        </a>
      </div>
    </div>
  </section>
</Layout>
